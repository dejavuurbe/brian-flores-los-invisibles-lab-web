---
import BaseLayout from '../layouts/BaseLayout.astro';
import {site} from '../content/site';
import {identityGraphSchema} from '../core/schema';
import {localPath} from '../core/paths';
const book = site.featuredBook;
---
<BaseLayout title="Brian Flores | Los Invisibles" description={site.description} schema={identityGraphSchema()}>
<section class="section hero" id="inicio"><div class="container hero-grid">
<div class="hero-copy"><p class="eyebrow">Buenos Aires · Escritor independiente</p><h1>Brian<br/><em>Flores</em></h1><p class="hero-line">{site.tagline}</p><a class="text-link" href="#obra">Entrar en Los Invisibles <span aria-hidden="true">↗</span></a></div>
<figure class="portrait-frame"><img src={localPath(site.author.photo)} alt="Retrato de Brian Flores" width="641" height="665"/><figcaption>El autor de <i>Los Invisibles</i></figcaption></figure>
</div><span class="ghost-word" aria-hidden="true">memoria</span></section>
<section class="section book-section" id="obra"><div class="container book-grid">
<figure class="book-image"><img src={localPath(book.cover)} alt="Portada original de Los Invisibles, de Brian Flores" width="1024" height="1536" loading="lazy"/></figure>
<div class="book-copy"><p class="eyebrow">La novela · 2025</p><h2>Los Invisibles</h2><p class="question">¿Qué queda de una persona cuando nadie puede recordarla?</p><p class="synopsis">{book.synopsis}</p><dl class="book-meta"><div><dt>Género</dt><dd>Misterio psicológico con elementos especulativos</dd></div><div><dt>Edición</dt><dd>Independiente · Argentina</dd></div><div><dt>ISBN · papel</dt><dd>{book.isbn}</dd></div></dl><div class="purchase">{book.purchaseLinks.map((link,i)=><a class={`button ${i?'secondary':''}`} href={link.url} target="_blank" rel="noopener noreferrer">{link.label}<span aria-hidden="true">↗</span></a>)}</div></div>
</div></section>
<section class="section biography" id="autor"><div class="container bio-grid"><div><p class="eyebrow">El autor</p><h2>Lo que permanece.</h2></div><div><p class="lead">{site.author.longBio}</p><a class="text-link" href={localPath('actividad/')}>Entrevistas, lecturas y cuentos <span aria-hidden="true">↗</span></a></div></div></section>
</BaseLayout>
<style>
.hero{position:relative;isolation:isolate;overflow:hidden;padding-block:clamp(2.8rem,6vh,5rem);min-height:min(calc(100svh - 105px),850px);display:grid;align-items:center;background:radial-gradient(ellipse at 75% 45%,#31412b55,transparent 62%)}
.hero-grid{display:grid;grid-template-columns:1.25fr .75fr;gap:5rem;align-items:center}.hero h1{font-size:clamp(5rem,9.5vw,8.8rem);letter-spacing:-.045em;line-height:.91}.hero em{font-weight:400;color:var(--color-accent)}.hero-line{max-width:26ch;font-family:var(--font-display);font-size:clamp(1.3rem,2.4vw,1.85rem);line-height:1.4;margin:1.7rem 0 1.9rem;color:var(--color-muted)}
.portrait-frame{margin:0;position:relative;padding:0 0 1.2rem 1.2rem}.portrait-frame:before{content:'';position:absolute;inset:1.2rem 1.2rem 0 0;border:1px solid var(--color-accent);z-index:-1;opacity:.5}.portrait-frame img{width:100%;filter:sepia(.16);object-fit:cover}.portrait-frame figcaption{margin-top:.65rem;font-size:.75rem;letter-spacing:.06em;color:var(--color-muted)}.ghost-word{position:absolute;z-index:-1;bottom:-.26em;left:4%;font-family:Georgia,serif;font-size:clamp(9rem,20vw,20rem);line-height:1;letter-spacing:-.05em;color:#d9ceab06;pointer-events:none}
.book-section{background:var(--color-surface);border-block:1px solid var(--color-border);padding-block:clamp(3rem,6vw,5rem)}.book-grid{display:grid;grid-template-columns:.85fr 1.15fr;gap:clamp(3rem,7vw,7rem);align-items:center}.book-image{margin:0}.book-image img{max-width:310px;width:100%;margin-inline:auto;box-shadow:0 25px 65px #0007}.book-copy h2{font-size:clamp(2.7rem,5vw,4.4rem)}.question{font-family:var(--font-display);font-size:clamp(1.35rem,2vw,1.65rem);line-height:1.4;color:var(--color-accent);max-width:33ch}.synopsis{color:var(--color-muted);max-width:57ch;font-size:1rem}.book-meta{margin:1.5rem 0;display:grid;grid-template-columns:1.4fr 1fr;gap:1rem}.book-meta div{border-top:1px solid var(--color-border);padding-top:.6rem}.book-meta dt{font-size:.65rem;letter-spacing:.12em;text-transform:uppercase;color:var(--color-accent)}.book-meta dd{margin:.25rem 0 0;font-size:.85rem}.purchase{display:flex;flex-wrap:wrap;gap:.7rem}.bio-grid{display:grid;grid-template-columns:1fr 1.25fr;gap:5rem}.biography .lead{margin-top:0}.biography h2{max-width:10ch}
@media(max-width:760px){.hero{min-height:auto;padding-block:3rem}.hero-grid{grid-template-columns:1fr;gap:2.5rem}.hero h1{font-size:clamp(4.8rem,18vw,7rem)}.portrait-frame{max-width:310px;margin:0 auto;width:85%}.hero-line{max-width:30ch}.book-grid,.bio-grid{grid-template-columns:1fr;gap:2.5rem}.book-image img{max-width:255px}.book-meta{grid-template-columns:1fr 1fr}.biography h2{max-width:none}.bio-grid .lead{font-size:1.1rem}}
</style>
